            <preferred-size width="300" height="50"/>
          </grid>
        </constraints>
        <properties>
          <font style="2"/>
          <text resource-bundle="UIstrings" key="homePage.taskButtonDescription.text"/>
        </properties>
      </component>
      <component id="f33c5" class="javax.swing.JButton" binding="modelButton">
        <constraints>
          <grid row="4" column="2" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="2" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="310" height="35"/>
          </grid>
        </constraints>
        <properties>
          <text resource-bundle="UIstrings" key="homePage.modelChoice.button"/>
