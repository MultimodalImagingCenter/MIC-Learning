          </grid>
        </constraints>
        <properties>
          <font style="2"/>
          <text resource-bundle="UIstrings" key="homePage.modelButtonDescription.text"/>
        </properties>
      </component>
      <component id="3b82f" class="javax.swing.JLabel" binding="askChoiceLabel">
        <constraints>
