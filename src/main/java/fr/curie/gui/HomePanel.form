<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="fr.curie.gui.HomePanel">
  <grid id="27dc6" binding="rootPanel" layout-manager="GridLayoutManager" row-count="6" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="20" right="10"/>
    <constraints>
      <xy x="20" y="20" width="1225" height="498"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="9d4a8" class="javax.swing.JButton" binding="taskButton">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="2" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="310" height="35"/>
          </grid>
        </constraints>
        <properties>
          <text resource-bundle="UIstrings" key="homePage.taskChoice.button"/>
        </properties>
      </component>
      <component id="edfc3" class="javax.swing.JLabel" binding="taskDescriptionLabel">
